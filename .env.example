# ---------------------------------------------------------------------------
# Operava site configuration
#
# Copy to .env.local for development, or set these in your hosting provider.
# NOTHING here is required to run the site — with zero configuration every
# lead is still written to the server log as a single JSON line prefixed
# `operava.lead`, so no submission is ever lost.
# ---------------------------------------------------------------------------


# --- Public: safe to expose, inlined into the browser bundle ----------------

# Canonical origin, no trailing slash. Drives metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://operavallc.com

# Inbox shown on the site. Must be an address you actually monitor.
NEXT_PUBLIC_CONTACT_EMAIL=alexpaisley@operavallc.com

# Scheduler link (Cal.com, Calendly, Google Appointments).
# When set, the booking confirmation page embeds a real time picker.
# When empty, the page says a human will follow up — we never show fake slots.
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/operava/discovery


# --- Lead delivery: email notification via Resend ---------------------------
# All three must be set for email to send. Resend is used over plain HTTP,
# so there is no SDK to install. https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# LEAD_NOTIFY_EMAIL=alexpaisley@operavallc.com
# LEAD_FROM_EMAIL=Operava Website <leads@operavallc.com>


# --- Lead delivery: webhook (Growth Engine) ---------------------------------
# Receives the exact same JSON lead object as the log line, POSTed as
# application/json. Point it at Growth Engine's ingestion endpoint:
#
#   LEAD_WEBHOOK_URL=https://<growth-engine-host>/api/operava/leads
#
# When LEAD_WEBHOOK_SECRET is set, each request is signed:
#
#   X-Operava-Signature: sha256=HMAC_SHA256(secret, `${timestamp}.` + rawBody)
#   X-Operava-Timestamp: <Date.now() in ms>
#
# The header carries a SIGNATURE, never the secret itself, and the timestamp is
# part of the signed message so a captured request cannot be replayed later.
# Growth Engine rejects anything older than five minutes.
#
# This value must be BYTE-IDENTICAL to OPERAVA_WEBHOOK_SECRET on Growth Engine.
# Generate one with:  openssl rand -hex 32
#
# Server-side only. Never rename this to NEXT_PUBLIC_* — that would inline the
# signing key into the browser bundle and let anyone forge leads.
#
# Confirm the far end is configured:
#   curl https://<growth-engine-host>/api/operava/leads/health
# LEAD_WEBHOOK_URL=https://growth.example.com/api/operava/leads
# LEAD_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32


# --- POST /api/leads --------------------------------------------------------
# Optional bearer token gate for the public lead endpoint. Unset means the
# endpoint is open. Set it before pointing anything external at it.
# LEAD_API_TOKEN=generate-a-long-random-string


# --- Client portal (Supabase) ----------------------------------------------
# Without the two NEXT_PUBLIC_ values, /portal renders an honest "not
# configured" screen and the marketing site is unaffected. `next build`
# succeeds either way.
#
# Project URL and anon/publishable key. Both are inlined into the browser
# bundle, which is correct: the anon key is a public identifier and every table
# it can reach is behind row level security.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or sb_publishable_ key>

# Server-side ONLY. Bypasses RLS completely, and is used for exactly one thing:
# creating auth users for customers, because public signup is disabled by
# design. Never rename this to NEXT_PUBLIC_* — that would ship a key that can
# read every customer's data to every browser.
#
# Without it the portal still works; only account provisioning is unavailable,
# and the admin UI says so.
# SUPABASE_SERVICE_ROLE_KEY=<service_role or sb_secret_ key>

# Manual step Supabase requires: add every origin the portal runs on to
# Authentication -> URL Configuration -> Redirect URLs, e.g.
#   http://localhost:3000/portal/auth/confirm
#   https://operavallc.com/portal/auth/confirm
# Setup and password-reset links silently fail without it. See docs/PORTAL.md.
